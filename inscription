
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>MedX — Inscription, Connexion & Validation des Forfaits</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    body {
      background: radial-gradient(circle at top, #0f2952 0%, #071326 75%);
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .hidden { display: none !important; }
    .container {
      width: 100%;
      max-width: 460px;
    }
    .container.wide {
      max-width: 960px;
    }
    .brand-header {
      text-align: center;
      margin-bottom: 18px;
    }
    .brand-logo {
      font-size: 2rem;
      font-weight: 900;
      color: #38bdf8;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .brand-logo span { color: #ffffff; }
    .brand-sub {
      font-size: 0.85rem;
      color: #94a3b8;
      margin-top: 4px;
    }
    .card {
      background: #0f1f38;
      border: 1px solid #1e3a66;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
    }
    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
    }
    .tab-btn {
      flex: 1;
      padding: 10px;
      border-radius: 9px;
      border: 1px solid #284675;
      background: #091528;
      color: #94a3b8;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .tab-btn.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
    }
    label {
      display: block;
      font-size: 0.84rem;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 6px;
    }
    input, select {
      width: 100%;
      padding: 11px 12px;
      border-radius: 9px;
      border: 1px solid #284675;
      background: #091528;
      color: #f8fafc;
      font-size: 0.92rem;
      margin-bottom: 14px;
    }
    input:focus, select:focus {
      outline: none;
      border-color: #38bdf8;
    }
    button {
      border: none;
      border-radius: 9px;
      padding: 11px 14px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
    }
    button:hover { opacity: 0.93; }
    .btn-primary { width: 100%; background: #0284c7; color: #ffffff; }
    .btn-green { background: #16a34a; color: #ffffff; }
    .btn-red { background: #dc2626; color: #ffffff; }
    .btn-slate { background: #1e293b; color: #e2e8f0; border: 1px solid #334155; width: 100%; margin-top: 10px; }
    .alert {
      padding: 11px 13px;
      border-radius: 9px;
      font-size: 0.85rem;
      margin-bottom: 14px;
      line-height: 1.45;
    }
    .alert-err { background: rgba(239, 68, 68, 0.18); color: #fca5a5; border: 1px solid #ef4444; }
    .alert-ok { background: rgba(34, 197, 94, 0.18); color: #86efac; border: 1px solid #22c55e; }
    .alert-warn { background: rgba(245, 158, 11, 0.18); color: #fcd34d; border: 1px solid #f59e0b; }

    /* Écran Bloqué / En attente de validation */
    .lock-icon {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: rgba(239, 68, 68, 0.18);
      color: #f87171;
      border: 1px solid #ef4444;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      margin: 0 auto 14px auto;
    }
    .contact-box {
      background: #091528;
      border: 1px solid #1e3a66;
      border-radius: 10px;
      padding: 12px;
      margin: 14px 0;
      font-size: 0.84rem;
      color: #cbd5e1;
      line-height: 1.5;
    }

    /* Tableau Administrateur de Validation */
    .admin-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid #1e3a66;
    }
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }
    .kpi-mini {
      background: #091528;
      border: 1px solid #1e3a66;
      border-radius: 10px;
      padding: 12px;
    }
    .kpi-mini span { font-size: 0.78rem; color: #94a3b8; display: block; }
    .kpi-mini strong { font-size: 1.35rem; color: #38bdf8; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th, td {
      padding: 10px 8px;
      text-align: left;
      border-bottom: 1px solid #1e3a66;
      font-size: 0.84rem;
      white-space: nowrap;
    }
    th { color: #93c5fd; background: #091528; }
    .badge {
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 800;
    }
    .b-ok { background: rgba(74, 222, 128, 0.18); color: #4ade80; }
    .b-wait { background: rgba(251, 191, 36, 0.18); color: #fbbf24; }
    .b-block { background: rgba(248, 113, 113, 0.18); color: #f87171; }
    .inline-select { width: auto; margin-bottom: 0; padding: 6px 8px; font-size: 0.78rem; }
  </style>
</head>
<body>

  <div id="main-container" class="container">
    <div class="brand-header">
      <div class="brand-logo">
        <i class="fa-solid fa-stethoscope"></i> Med<span>X</span>
      </div>
      <div class="brand-sub">Portail d'Inscription, Validation des Forfaits & Accès</div>
    </div>

    <!-- ===================================================================
         VUE 1 : INSCRIPTION & CONNEXION (ÉTUDIANT OU ADMINISTRATEUR)
         =================================================================== -->
    <div id="auth-view" class="card">
      <div class="tabs">
        <button id="tab-register" class="tab-btn active" type="button">Inscription Étudiant</button>
        <button id="tab-login" class="tab-btn" type="button">Connexion</button>
      </div>

      <div id="auth-msg" class="alert hidden"></div>

      <!-- Formulaire Inscription -->
      <form id="register-form">
        <label for="reg-name">Nom et Prénom</label>
        <input id="reg-name" type="text" placeholder="Ex: Rakotoarisoa Jean" required />

        <label for="reg-email">Adresse Gmail</label>
        <input id="reg-email" type="email" placeholder="votre.nom@gmail.com" required />

        <label for="reg-password">Mot de passe (min. 6 caractères)</label>
        <input id="reg-password" type="password" minlength="6" placeholder="Créer un mot de passe" required />

        <button class="btn-primary" type="submit">
          <i class="fa-solid fa-user-plus"></i> S'inscrire et demander l'accès
        </button>
      </form>

      <!-- Formulaire Connexion -->
      <form id="login-form" class="hidden">
        <label for="login-email">Adresse Gmail</label>
        <input id="login-email" type="email" placeholder="exemple@gmail.com" required />

        <label for="login-password">Mot de passe</label>
        <input id="login-password" type="password" placeholder="Votre mot de passe" required />

        <button class="btn-primary" type="submit">
          <i class="fa-solid fa-right-to-bracket"></i> Se connecter à MedX
        </button>
      </form>
    </div>

    <!-- ===================================================================
         VUE 2 : UTILISATEUR BLOQUÉ / EN ATTENTE DE VALIDATION DU FORFAIT
         =================================================================== -->
    <div id="blocked-view" class="card hidden" style="text-align:center;">
      <div class="lock-icon"><i class="fa-solid fa-lock"></i></div>
      <h2 style="font-size:1.25rem; margin-bottom:8px;">Accès en attente ou suspendu</h2>

      <div id="blocked-msg" class="alert alert-warn">
        Votre compte est bien enregistré, mais votre forfait MedX n'est pas encore activé ou est épuisé.
      </div>

      <div class="contact-box">
        <div><strong>Compte :</strong> <span id="blocked-user-email"></span></div>
        <div style="margin-top:6px;">
          Contactez l'administrateur <strong>Dr RABIBISOA</strong> pour valider votre paiement et activer votre forfait (7, 30, 90 ou 365 jours) :
        </div>
        <div style="margin-top:6px; color:#38bdf8; font-weight:700;">
          <i class="fa-solid fa-phone"></i> 034 20 026 23 &nbsp;|&nbsp; <i class="fa-solid fa-envelope"></i> rabherilala@gmail.com
        </div>
      </div>

      <button id="refresh-status-btn" class="btn-primary" type="button">
        <i class="fa-solid fa-rotate"></i> Vérifier si mon forfait est activé
      </button>
      <button id="blocked-logout-btn" class="btn-slate" type="button">
        <i class="fa-solid fa-right-from-bracket"></i> Se déconnecter
      </button>
    </div>

    <!-- ===================================================================
         VUE 3 : PANNEAU ADMINISTRATEUR (rabherilala@gmail.com)
         C'est ici que vous validez chaque Gmail + mot de passe et attribuez le forfait.
         =================================================================== -->
    <div id="admin-view" class="card hidden">
      <div class="admin-top">
        <div>
          <h2 style="font-size:1.15rem;"><i class="fa-solid fa-crown" style="color:#f59e0b;"></i> Validation des Forfaits MedX</h2>
          <p style="font-size:0.8rem; color:#94a3b8;">Connecté en tant qu'administrateur : <strong>rabherilala@gmail.com</strong></p>
        </div>
        <button id="admin-logout-btn" class="btn-slate" style="width:auto; margin-top:0;" type="button">
          <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
        </button>
      </div>

      <div id="admin-toast" class="alert alert-ok hidden"></div>

      <div class="kpi-row">
        <div class="kpi-mini"><span>Total inscrits</span><strong id="st-total">0</strong></div>
        <div class="kpi-mini"><span>Forfaits actifs</span><strong id="st-active" style="color:#4ade80;">0</strong></div>
        <div class="kpi-mini"><span>En attente / Expirés</span><strong id="st-blocked" style="color:#f87171;">0</strong></div>
      </div>

      <input id="admin-search" type="text" placeholder="Rechercher un étudiant par nom ou Gmail..." />

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Étudiant</th>
              <th>Gmail</th>
              <th>Statut</th>
              <th>Expiration</th>
              <th>Forfait</th>
              <th>Autorisation</th>
            </tr>
          </thead>
          <tbody id="users-tbody">
            <tr><td colspan="6">Chargement des comptes...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import {
      getAuth,
      createUserWithEmailAndPassword,
      signInWithEmailAndPassword,
      signOut,
      onAuthStateChanged
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
    import {
      getFirestore,
      collection,
      doc,
      setDoc,
      getDoc,
      updateDoc,
      onSnapshot,
      query,
      where,
      serverTimestamp
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    // =========================================================================
    // 1. CONFIGURATION DE VOTRE PROJET FIREBASE (REMPLACEZ PAR VOS CLÉS)
    // =========================================================================
    const firebaseConfig = {
      apiKey: "VOTRE_CLE_API_FIREBASE",
      authDomain: "VOTRE_PROJET.firebaseapp.com",
      projectId: "VOTRE_PROJET_ID",
      storageBucket: "VOTRE_PROJET.appspot.com",
      messagingSenderId: "VOTRE_SENDER_ID",
      appId: "VOTRE_APP_ID"
    };

    // =========================================================================
    // 2. LIEN VERS VOTRE APPLICATION MEDX (APRÈS VALIDATION DU FORFAIT)
    // =========================================================================
    const MEDX_APP_URL = "MedX_App_Corrige.html"; // Ou l'URL complète de votre application MedX
    const ADMIN_EMAIL = "rabherilala@gmail.com";

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const mainContainer = document.getElementById("main-container");
    const authView = document.getElementById("auth-view");
    const blockedView = document.getElementById("blocked-view");
    const adminView = document.getElementById("admin-view");
    const authMsg = document.getElementById("auth-msg");

    const tabRegister = document.getElementById("tab-register");
    const tabLogin = document.getElementById("tab-login");
    const registerForm = document.getElementById("register-form");
    const loginForm = document.getElementById("login-form");

    let allUsers = [];
    let unsubscribeUsers = null;

    function showAuthMsg(text, type = "err") {
      authMsg.textContent = text;
      authMsg.className = `alert alert-${type}`;
    }

    function showOnlyView(view) {
      authView.classList.add("hidden");
      blockedView.classList.add("hidden");
      adminView.classList.add("hidden");
      mainContainer.classList.remove("wide");
      view.classList.remove("hidden");
      if (view === adminView) {
        mainContainer.classList.add("wide");
      }
    }

    function isGmail(email) {
      return email.trim().toLowerCase().endsWith("@gmail.com");
    }

    function hasValidSubscription(userData) {
      if (!userData) return false;
      if (userData.blocked === true || userData.subscriptionActive !== true) return false;
      if (!userData.expiresAt) return false;
      return new Date(userData.expiresAt).getTime() > Date.now();
    }

    // Basculer Inscription / Connexion
    tabRegister.addEventListener("click", () => {
      tabRegister.classList.add("active");
      tabLogin.classList.remove("active");
      registerForm.classList.remove("hidden");
      loginForm.classList.add("hidden");
      authMsg.classList.add("hidden");
    });

    tabLogin.addEventListener("click", () => {
      tabLogin.classList.add("active");
      tabRegister.classList.remove("active");
      loginForm.classList.remove("hidden");
      registerForm.classList.add("hidden");
      authMsg.classList.add("hidden");
    });

    // Inscription : enregistre le Gmail + mot de passe dans Firebase Auth et met le compte en attente de validation
    registerForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      authMsg.classList.add("hidden");

      const fullName = document.getElementById("reg-name").value.trim();
      const email = document.getElementById("reg-email").value.trim().toLowerCase();
      const password = document.getElementById("reg-password").value;

      if (!isGmail(email)) {
        showAuthMsg("Veuillez entrer une adresse @gmail.com valide.", "err");
        return;
      }

      try {
        const cred = await createUserWithEmailAndPassword(auth, email, password);
        const isAdminAccount = email === ADMIN_EMAIL;

        await setDoc(doc(db, "users", cred.user.uid), {
          fullName: isAdminAccount ? "Dr RABIBISOA (Admin)" : fullName,
          email: email,
          role: isAdminAccount ? "admin" : "student",
          subscriptionActive: isAdminAccount ? true : false,
          blocked: false,
          planDays: 0,
          expiresAt: isAdminAccount ? "2099-12-31T23:59:59.000Z" : null,
          createdAt: serverTimestamp()
        });
      } catch (err) {
        if (err.code === "auth/email-already-in-use") {
          showAuthMsg("Ce Gmail est déjà inscrit. Cliquez sur l'onglet « Connexion ».", "warn");
        } else {
          showAuthMsg("Erreur d'inscription : " + err.message, "err");
        }
      }
    });

    // Connexion
    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      authMsg.classList.add("hidden");

      const email = document.getElementById("login-email").value.trim().toLowerCase();
      const password = document.getElementById("login-password").value;

      if (!isGmail(email)) {
        showAuthMsg("Veuillez entrer une adresse @gmail.com valide.", "err");
        return;
      }

      try {
        await signInWithEmailAndPassword(auth, email, password);
      } catch (err) {
        showAuthMsg("Gmail ou mot de passe incorrect.", "err");
      }
    });

    // Vérification automatique du compte et du forfait
    async function verifyUserAccess(user) {
      const email = (user.email || "").toLowerCase();
      const userRef = doc(db, "users", user.uid);
      let snap = await getDoc(userRef);

      // Si l'administrateur rabherilala@gmail.com se connecte pour la première fois
      if (!snap.exists() && email === ADMIN_EMAIL) {
        await setDoc(userRef, {
          fullName: "Dr RABIBISOA (Admin)",
          email: ADMIN_EMAIL,
          role: "admin",
          subscriptionActive: true,
          blocked: false,
          planDays: 3650,
          expiresAt: "2099-12-31T23:59:59.000Z",
          createdAt: serverTimestamp()
        });
        snap = await getDoc(userRef);
      }

      const data = snap.exists() ? snap.data() : null;

      // 1. Si c'est l'administrateur rabherilala@gmail.com
      if (email === ADMIN_EMAIL || (data && data.role === "admin")) {
        showOnlyView(adminView);
        startAdminListener();
        return;
      }

      // 2. Si c'est un étudiant : vérifier s'il a un forfait actif non épuisé
      if (hasValidSubscription(data)) {
        // Autorisé -> Redirection automatique vers l'application MedX avec jeton de session
        const sessionPayload = encodeURIComponent(JSON.stringify({
          uid: user.uid,
          email: email,
          expiresAt: data.expiresAt
        }));
        window.location.href = MEDX_APP_URL + "?medx_auth=" + sessionPayload;
      } else {
        // Non payé ou forfait épuisé -> Bloqué sur la page d'inscription/attente
        document.getElementById("blocked-user-email").textContent = email;
        const msgEl = document.getElementById("blocked-msg");
        if (data && data.expiresAt && new Date(data.expiresAt).getTime() <= Date.now()) {
          msgEl.textContent = "Votre forfait MedX est épuisé. Veuillez renouveler votre abonnement auprès de l'administrateur.";
        } else {
          msgEl.textContent = "Votre inscription est enregistrée. Votre accès est bloqué en attendant la validation de votre forfait par l'administrateur.";
        }
        showOnlyView(blockedView);
      }
    }

    // Panneau Administrateur : liste en temps réel des étudiants
    function startAdminListener() {
      if (unsubscribeUsers) unsubscribeUsers();
      const q = query(collection(db, "users"), where("role", "==", "student"));
      unsubscribeUsers = onSnapshot(q, (snapshot) => {
        allUsers = [];
        snapshot.forEach((d) => allUsers.push({ id: d.id, ...d.data() }));
        renderAdminTable();
      });
    }

    function renderAdminTable() {
      const search = document.getElementById("admin-search").value.trim().toLowerCase();
      const tbody = document.getElementById("users-tbody");

      let activeCount = 0;
      let blockedCount = 0;

      allUsers.forEach((u) => {
        if (hasValidSubscription(u)) activeCount++;
        else blockedCount++;
      });

      document.getElementById("st-total").textContent = allUsers.length;
      document.getElementById("st-active").textContent = activeCount;
      document.getElementById("st-blocked").textContent = blockedCount;

      const filtered = allUsers.filter((u) => {
        return !search ||
          (u.fullName && u.fullName.toLowerCase().includes(search)) ||
          (u.email && u.email.toLowerCase().includes(search));
      });

      tbody.innerHTML = "";
      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6">Aucun étudiant inscrit pour le moment.</td></tr>`;
        return;
      }

      filtered.forEach((u) => {
        const valid = hasValidSubscription(u);
        const expired = u.expiresAt && new Date(u.expiresAt).getTime() <= Date.now();
        const badgeClass = valid ? "b-ok" : (expired ? "b-block" : "b-wait");
        const badgeText = valid ? "Forfait actif" : (expired ? "Forfait épuisé" : "En attente");
        const expDate = u.expiresAt ? new Date(u.expiresAt).toLocaleDateString("fr-FR") : "Non activé";

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td><strong>${u.fullName || "Étudiant"}</strong></td>
          <td>${u.email}</td>
          <td><span class="badge ${badgeClass}">${badgeText}</span></td>
          <td>${expDate}</td>
          <td>
            <select id="plan-${u.id}" class="inline-select">
              <option value="7">7 jours</option>
              <option value="30" selected>30 jours</option>
              <option value="90">90 jours</option>
              <option value="365">365 jours</option>
            </select>
          </td>
          <td>
            <button class="btn-green" style="padding:6px 10px; font-size:0.78rem;" data-act="activate" data-id="${u.id}" type="button">
              <i class="fa-solid fa-check"></i> Valider
            </button>
            <button class="btn-red" style="padding:6px 10px; font-size:0.78rem;" data-act="block" data-id="${u.id}" type="button">
              <i class="fa-solid fa-ban"></i> Bloquer
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    document.getElementById("admin-search").addEventListener("input", renderAdminTable);

    document.getElementById("users-tbody").addEventListener("click", async (e) => {
      const btn = e.target.closest("button[data-act]");
      if (!btn) return;
      const uid = btn.dataset.id;
      const act = btn.dataset.act;
      const toast = document.getElementById("admin-toast");

      if (act === "activate") {
        const days = Number(document.getElementById("plan-" + uid).value || 30);
        const expiresAt = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();
        await updateDoc(doc(db, "users", uid), {
          subscriptionActive: true,
          blocked: false,
          planDays: days,
          expiresAt: expiresAt
        });
        toast.textContent = `Forfait activé pour ${days} jours.`;
        toast.classList.remove("hidden");
        setTimeout(() => toast.classList.add("hidden"), 3000);
      } else if (act === "block") {
        await updateDoc(doc(db, "users", uid), {
          subscriptionActive: false,
          blocked: true
        });
        toast.textContent = "Accès utilisateur bloqué.";
        toast.classList.remove("hidden");
        setTimeout(() => toast.classList.add("hidden"), 3000);
      }
    });

    document.getElementById("refresh-status-btn").addEventListener("click", async () => {
      if (auth.currentUser) {
        await verifyUserAccess(auth.currentUser);
      }
    });

    async function doLogout() {
      if (unsubscribeUsers) unsubscribeUsers();
      await signOut(auth);
    }
    document.getElementById("blocked-logout-btn").addEventListener("click", doLogout);
    document.getElementById("admin-logout-btn").addEventListener("click", doLogout);

    onAuthStateChanged(auth, async (user) => {
      if (user) {
        await verifyUserAccess(user);
      } else {
        showOnlyView(authView);
      }
    });
  </script>
</body>
</html>
